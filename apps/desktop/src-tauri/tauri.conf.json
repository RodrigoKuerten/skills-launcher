{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Hub Companion",
  "version": "0.1.0",
  "identifier": "tools.skillshub.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skills Hub Companion",
        "width": 620,
        "height": 560,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/skills-hub-agent"]
  }
}
