# Database
DATABASE_URL="file:./dev.db"

# Public app URL (used by the local companion)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AGENT_URL="http://127.0.0.1:4780"

# Required for the cron endpoint in production; leave empty for local-only work
CRON_SECRET=""

# Optional: raises GitHub API rate limit from 60 to 5000 req/h
GITHUB_TOKEN=""

# Seed credentials. Development falls back to the documented demo values;
# production seeding requires a non-default ADMIN_PASSWORD.
ADMIN_EMAIL="admin@skills.hub"
ADMIN_PASSWORD=""
DEMO_EMAIL="demo@skills.hub"
DEMO_PASSWORD=""

# Local companion: only these browser origins may call it
AGENT_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional: create in Profile and start the companion with this to report installs
SKILLS_HUB_API_TOKEN=""
