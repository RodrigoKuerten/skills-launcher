{
  "name": "ai-skills-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @skills-hub/web",
    "build": "npm run build -w @skills-hub/web",
    "start": "npm run start -w @skills-hub/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w @skills-hub/web && node node_modules/typescript/bin/tsc --noEmit -p apps/agent/tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p packages/core/tsconfig.json",
    "db:push": "npm run db:push -w @skills-hub/web",
    "db:seed": "npm run db:seed -w @skills-hub/web",
    "sync": "npm run sync -w @skills-hub/web",
    "agent": "npm run dev -w @skills-hub/agent",
    "agent:cli": "npm run cli -w @skills-hub/agent --",
    "agent:detect": "npm run detect -w @skills-hub/agent",
    "dev:desktop": "npm run dev -w @skills-hub/desktop",
    "build:desktop": "npm run build -w @skills-hub/desktop"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.20.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "effect": "^3.20.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
